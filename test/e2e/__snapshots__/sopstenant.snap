
[TestSopsTenantGeneratesKey - 1 - [sopstenant] ready]
apiVersion: sops.stakater.com/v1alpha1
kind: SopsTenant
metadata:
  creationTimestamp: <Any value>
  generation: 1
  managedFields: <Any value>
  name: solar
  namespace: e2e-tenant-ready
  resourceVersion: <Any value>
  uid: <Any value>
spec:
  generateKey: true
status:
  conditions:
  - lastTransitionTime: <Any value>
    message: generated a post-quantum key
    observedGeneration: 1
    reason: KeyGenerated
    status: "True"
    type: Ready
  observedGeneration: 1

---

[TestSopsTenantNotOnboarded - 1 - [sopstenant] not onboarded]
apiVersion: sops.stakater.com/v1alpha1
kind: SopsTenant
metadata:
  creationTimestamp: <Any value>
  generation: 1
  managedFields: <Any value>
  name: solar
  namespace: e2e-tenant-denied
  resourceVersion: <Any value>
  uid: <Any value>
spec:
  generateKey: true
status:
  conditions:
  - lastTransitionTime: <Any value>
    message: the tenant identity cannot read its key Secret; the cluster admin must onboard this tenant
    observedGeneration: 1
    reason: AccessDenied
    status: "False"
    type: Ready
  observedGeneration: 1

---
